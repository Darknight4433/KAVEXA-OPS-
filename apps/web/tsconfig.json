{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@kavexa/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@kavexa/utils": ["../../packages/utils/src/index.ts"],
      "@kavexa/intelligence": ["../../packages/intelligence/src/index.ts"],
      "@kavexa/firebase": ["../../packages/firebase/src/index.ts"],
      "firebase": ["./node_modules/firebase"],
      "firebase/*": ["./node_modules/firebase/*"]
    }
  },
  "include": ["src", "../../packages"]
}
